# Validate .trivyignore.yaml entries for repository-specific rules added on top
# of Trivy: every entry in any sequence must be a mapping with non-empty,
# non-whitespace string `id` and `statement` fields.
#
# Invoked by lefthook (`yq --yaml-fix-merge-anchor-to-spec=true --from-file`).
# YAML syntax, structural types, duplicate keys, and `expired_at` dates are
# validated by Trivy at scan time (`mise run scan`).

filename as $file |
# Expand YAML aliases and `<<:` merge keys before inspecting entries.
explode(.) |
[
  select(tag == "!!map") |
  to_entries[] |
  select((.value | tag) == "!!seq" and (.value | length) > 0) |
  .key as $cat |
  .value | to_entries[] | .key as $idx | .value as $e |
  {
    "cat": $cat,
    "idx": $idx,
    "line": ($e | line),
    "err": (
      if ($e | tag) != "!!map" then "entry must be a mapping with id and statement"
      elif ($e.id | tag) != "!!str" or (($e.id | test("\\S")) | not) then "missing or empty id"
      elif ($e.statement | tag) != "!!str" or (($e.statement | test("\\S")) | not) then "missing or empty statement"
      else "" end
    )
  }
] |
map(select(.err != "")) |
map("\($file): \(.cat)[\(.idx)] (line \(.line)): \(.err)") |
if length > 0 then error(join("\n")) else null end
